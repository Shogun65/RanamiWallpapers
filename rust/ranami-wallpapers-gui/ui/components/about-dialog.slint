import { SidebarButton } from "sidebar-button.slint";
import { Theme } from "../theme.slint";

export component AboutDialog inherits Rectangle {
    callback close();
    background: Theme.dialog-backdrop;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(620px, root.width - 64px);
        height: 500px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.dialog-surface;
        border-radius: Theme.radius-dialog;
        border-width: Theme.border-thin;
        border-color: Theme.dialog-border;
        clip: true;

        SidebarButton {
            x: parent.width - 114px;
            y: 18px;
            width: 90px;
            title: "Close";
            clicked => { root.close(); }
        }

        Text {
            x: 24px;
            y: 24px;
            width: parent.width - 150px;
            height: 30px;
            text: "Ranami Wallpapers";
            color: Theme.text-primary;
            font-size: Theme.font-dialog-title;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            x: 24px;
            y: 66px;
            width: parent.width - 48px;
            height: 40px;
            text: "Windows live wallpapers with a native rendering core and a simple desktop app experience.";
            color: Theme.text-secondary;
            font-size: Theme.font-dialog-body;
            wrap: word-wrap;
        }

        Rectangle {
            x: 24px;
            y: 126px;
            width: parent.width - 48px;
            height: 64px;
            background: Theme.dialog-section;
            border-radius: Theme.radius-medium;
            border-width: Theme.border-thin;
            border-color: Theme.dialog-section-border;

            Text {
                x: 16px;
                y: 10px;
                width: parent.width - 32px;
                height: 16px;
                text: "Version";
                color: Theme.text-label;
                font-size: Theme.font-label;
                font-weight: 600;
            }

            Text {
                x: 16px;
                y: 30px;
                width: parent.width - 32px;
                height: 20px;
                text: "v0.3.0-beta";
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 600;
            }
        }

        Rectangle {
            x: 24px;
            y: 202px;
            width: parent.width - 48px;
            height: 76px;
            background: Theme.dialog-section;
            border-radius: Theme.radius-medium;
            border-width: Theme.border-thin;
            border-color: Theme.dialog-section-border;

            Text {
                x: 16px;
                y: 10px;
                width: parent.width - 32px;
                height: 16px;
                text: "Built with";
                color: Theme.text-label;
                font-size: Theme.font-label;
                font-weight: 600;
            }

            Text {
                x: 16px;
                y: 30px;
                width: parent.width - 32px;
                height: 28px;
                text: "C++, Rust, DirectX 11, DirectComposition, Slint, FFmpeg";
                color: Theme.text-primary;
                font-size: 15px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            x: 24px;
            y: 290px;
            width: parent.width - 48px;
            height: 96px;
            background: Theme.dialog-section;
            border-radius: Theme.radius-medium;
            border-width: Theme.border-thin;
            border-color: Theme.dialog-section-border;

            Text {
                x: 16px;
                y: 10px;
                width: parent.width - 32px;
                height: 16px;
                text: "Special thanks";
                color: Theme.text-label;
                font-size: Theme.font-label;
                font-weight: 600;
            }

            Text {
                x: 16px;
                y: 30px;
                width: parent.width - 32px;
                height: 44px;
                text: "FFmpeg, D3D11, Slint, and the APIs that made this project possible.";
                color: Theme.text-primary;
                font-size: 15px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            x: 24px;
            y: 398px;
            width: parent.width - 48px;
            height: 58px;
            background: Theme.dialog-section;
            border-radius: Theme.radius-medium;
            border-width: Theme.border-thin;
            border-color: Theme.dialog-section-border;

            Text {
                x: 16px;
                y: 10px;
                width: parent.width - 32px;
                height: 16px;
                text: "License";
                color: Theme.text-label;
                font-size: Theme.font-label;
                font-weight: 600;
            }

            Text {
                x: 16px;
                y: 28px;
                width: parent.width - 32px;
                height: 18px;
                text: "AGPL v3";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 600;
            }
        }

        Text {
            x: 24px;
            y: 468px;
            width: parent.width - 48px;
            height: 18px;
            text: "© Shogun65 2026";
            color: Theme.text-footer;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }
}
