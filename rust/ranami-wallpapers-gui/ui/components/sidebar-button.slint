import { Theme } from "../theme.slint";

export component SidebarButton inherits Rectangle {
    // Reusable sidebar button so every menu item keeps the same size and hover behavior.
    height: Theme.button-height;
    background: Theme.button-background;
    border-radius: Theme.radius-small;
    border-width: Theme.border-thin;
    border-color: Theme.button-border;

    in property <string> title;
    // Some sidebar actions, such as Import, intentionally stay visually quiet
    // and can opt out of the standard hover treatment.
    in property <bool> hover-enabled: true;
    callback clicked();

    Text {
        x: Theme.spacing-small;
        text: title;
        color: Theme.text-primary;
        font-size: Theme.font-button;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    // Hover feedback helps placeholder buttons still feel interactive and consistent.
    states [
        hover when ta.has-hover && root.hover-enabled: {
            background: Theme.button-background;
            border-color: Theme.button-hover-border;
        }
    ]
}
