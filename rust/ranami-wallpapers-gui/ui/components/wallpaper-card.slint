import { Theme } from "../theme.slint";

export struct WallpaperCardData {
    title: string,
    path: string,
    format: string,
    details: string,
    thumbnail: image,
    has_thumbnail: bool,
    is_loading: bool,
}

export component WallpaperCard inherits Rectangle {
    // Each card receives everything it needs from Rust in one small data object.
    in property <WallpaperCardData> data;
    callback wallpaper_card_double_clicked(string);

    min-width: 220px;
    preferred-width: 240px;
    max-width: 280px;
    height: Theme.card-height;

    clip: true;
    background: Theme.card-background;
    border-radius: Theme.radius-large;
    border-width: Theme.border-thin;
    border-color: Theme.card-border;

    Rectangle {
        x: Theme.spacing-small;
        y: Theme.spacing-small;
        width: parent.width - Theme.spacing-small * 2;
        height: Theme.thumbnail-height;
        background: Theme.preview-background;
        border-radius: Theme.spacing-small;
        clip: true;

        if data.has_thumbnail: Image {
            width: parent.width;
            height: parent.height;
            source: data.thumbnail;
            image-fit: cover;
        }

        if !data.has_thumbnail: Rectangle {
            background: Theme.preview-background;

            Text {
                width: parent.width;
                y: parent.height / 2 - 11px;
                height: 22px;
                text: data.is_loading ? "Loading preview..." : "Preview unavailable";
                color: Theme.text-accent;
                font-size: Theme.font-body;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            x: Theme.radius-medium;
            y: Theme.radius-medium;
            width: 72px;
            height: 24px;
            background: Theme.accent;
            border-radius: Theme.radius-medium;

            Text {
                text: data.format;
                color: Theme.text-primary;
                font-size: Theme.font-detail;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Text {
        x: Theme.radius-medium;
        y: 154px;
        width: parent.width - Theme.radius-medium * 2;
        height: 24px;
        text: data.title;
        color: Theme.text-primary;
        font-size: Theme.font-card-title;
        font-weight: 600;
        overflow: elide;
    }

    Text {
        x: Theme.radius-medium;
        y: 184px;
        width: parent.width - Theme.radius-medium * 2;
        height: 18px;
        text: data.path;
        color: Theme.text-muted;
        font-size: Theme.font-label;
        overflow: elide;
    }

    Text {
        x: Theme.radius-medium;
        y: 208px;
        width: parent.width - Theme.radius-medium * 2;
        height: 14px;
        text: data.details;
        color: Theme.text-dim; 
        font-size: Theme.font-detail;
        overflow: elide;
    }

    TouchArea {
        double-clicked => { root.wallpaper_card_double_clicked(data.path); }
    }
}
