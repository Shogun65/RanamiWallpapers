import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { AppSidebar } from "components/app-sidebar.slint";
import { AboutDialog } from "components/about-dialog.slint";
import { LibraryView } from "views/library-view.slint";
import { WallpaperCardData } from "components/wallpaper-card.slint";

// This is deliberately the small composition root for the GUI. Rust continues
// to compile this file and talks only to the properties and callbacks below.
export { WallpaperCardData } from "components/wallpaper-card.slint";

export component AppWindow inherits Window {
    width: 1250px;
    height: 700px;

    icon: @image-url("../../assets/RanamiIcon.ico");
    title: "Ranami Wallpapers";

    background: #08070d;

    callback import_wallpaper();
    callback wallpaper_card_double_clicked(string);
    // Rust owns the wallpaper list and pushes card data into this window property.
    in-out property <[WallpaperCardData]> wallpapers: [];
    in-out property <bool> about_open: false;

    HorizontalBox {
        height: root.height;
        padding: 16px;
        spacing: 16px;

        AppSidebar {
            width: 220px;
            import_wallpaper => { root.import_wallpaper(); }
            show_about => { root.about_open = true; }
        }

        LibraryView {
            wallpapers: root.wallpapers;
            wallpaper_card_double_clicked(wallpaper_path) => {
                root.wallpaper_card_double_clicked(wallpaper_path);
            }
        }
    }

    if root.about_open: AboutDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        close => { root.about_open = false; }
    }
}
